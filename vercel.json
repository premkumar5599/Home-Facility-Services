{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:production",
  "outputDirectory": "out",
  "functions": {
    "api/**/*.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/enquiry/", "destination": "/api/enquiry" },
    { "source": "/api/enquiry/key/", "destination": "/api/enquiry/key" }
  ]
}
