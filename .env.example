# Confirmed main domain. Copy this file to the appropriate local/host environment.
SITE_URL=https://homefacilityservices.in

# Enable only on the public deployment. Preview builds remain non-indexable.
SITE_INDEXABLE=false

# Zoho sender: use the exact host shown in the mailbox SMTP settings.
SMTP_HOST=REPLACE_WITH_ZOHO_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SENDER_EMAIL
SMTP_PASS=REPLACE_WITH_ZOHO_APP_PASSWORD
ENQUIRY_FROM=REPLACE_WITH_SENDER_EMAIL
ENQUIRY_TO=hr@homefacilityservices.in
ENQUIRY_TEST_MODE=false
ENQUIRY_ALLOWED_ORIGINS=https://homefacilityservices.in,https://www.homefacilityservices.in,https://home-facility-services.vercel.app

# Required in Vercel. Import the complete PKCS#8 PEM as a Secret (multiline).
# Generate with npm run generate:enquiry-key, then copy .local/enquiry-private.pem.
# Never put this key in NEXT_PUBLIC variables or public/.
ENQUIRY_PRIVATE_KEY=REPLACE_WITH_COMPLETE_PRIVATE_KEY_PEM

# Only needed for an exported site when the email endpoint is on another host.
# Never add email API keys to NEXT_PUBLIC variables.
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://your-email-endpoint/api/enquiry
